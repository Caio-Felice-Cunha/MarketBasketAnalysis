# Optional MySQL/MariaDB connection for the R script.
# The analysis reads Datasets/dataset_bd3.csv by default and needs none of
# these. Set them only if you uncomment the database path in
# "Market Basket Analysis.R". Copy this file to .env and fill in real values.
# .env is gitignored, so credentials never get committed.
MBA_DB_USER=root
MBA_DB_PASS=
MBA_DB_NAME=retail
MBA_DB_HOST=127.0.0.1
